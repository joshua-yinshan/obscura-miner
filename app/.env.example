# 复制为 .env.local 后填写

# 部署后的合约地址
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 链 ID（Obscura Testnet 用 31337；Base Sepolia 用 84532；Sepolia 用 11155111）
NEXT_PUBLIC_CHAIN_ID=31337

# RPC URL（指向 proxy 的 /rpc，**不要**直连 Anvil）
NEXT_PUBLIC_RPC_URL=http://localhost:3001/rpc

# Faucet endpoint
NEXT_PUBLIC_FAUCET_URL=http://localhost:3001/faucet

# Stats endpoint
NEXT_PUBLIC_STATS_URL=http://localhost:3001/stats

# 链名（用户钱包里显示这个）
NEXT_PUBLIC_CHAIN_NAME=Obscura Testnet
