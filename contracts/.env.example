# 复制此文件为 .env 后填入真实值

# 部署私钥（不要提交到 git！测试网钱包，里面只有水龙头领的小额测试 ETH）
PRIVATE_KEY=0xyour_private_key_here

# Base Sepolia RPC（推荐使用免费节点）
# 选项 1: 官方 https://sepolia.base.org
# 选项 2: Alchemy / Infura 注册免费 key
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# （可选）Ethereum Sepolia RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Basescan API key (验证合约用，可去 basescan.org 免费注册)
BASESCAN_API_KEY=your_basescan_api_key

# Etherscan API key
ETHERSCAN_API_KEY=your_etherscan_api_key
